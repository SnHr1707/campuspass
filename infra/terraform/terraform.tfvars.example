# Copy to terraform.tfvars (git-ignored) and fill in. See docs/DEPLOY.md for where each value comes from.
ssh_public_key_path = "C:/Users/YourName/.ssh/id_ed25519.pub"
admin_cidr          = "203.0.113.7/32" # your public IP + /32 (curl.exe -s https://checkip.amazonaws.com)
duckdns_subdomain   = "campuspass"
duckdns_token       = "00000000-0000-0000-0000-000000000000"
alert_email         = "you@example.com"

# Optional (defaults shown):
# region             = "ap-south-1"   # Mumbai
# aws_profile        = "campuspass"
# instance_type      = "t4g.large"
# monthly_budget_usd = 50
