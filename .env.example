# Copy this file to .env and change every value before deploying anywhere public.
# .env is git-ignored, so real secrets never reach GitHub.

POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
BOOKING_DB_PASSWORD=change-me-booking
TICKET_DB_PASSWORD=change-me-ticket

# At least 32 characters each. Generate with:  openssl rand -hex 32
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
TICKET_SIGNING_SECRET=local-dev-ticket-secret-change-me-012345

# Share these only with organisers and volunteers.
ORGANISER_INVITE_CODE=ORG-2026
VOLUNTEER_INVITE_CODE=VOL-2026
